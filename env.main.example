# ──────────────────────────────────────────────────────────────
# Mas Cerca AP — Main App — Variables de entorno
# En desarrollo: copiar a .env.local y completar los valores
# En Hostinger:  cargar cada variable en hPanel > Node.js > App
# ──────────────────────────────────────────────────────────────

# Supabase — solo anon key (la service role key vive en admin-app)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL del admin standalone
# Desarrollo: http://localhost:3001
# Produccion: https://admin.mascercap.com
ADMIN_APP_URL=http://localhost:3001

# WhatsApp Business
NEXT_PUBLIC_WHATSAPP_NUMBER=57XXXXXXXXXX
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Resend — formulario de contacto, pedidos y leads
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_TO_EMAIL=tu@email.com
RESEND_FROM_EMAIL=noreply@mascercap.com

# Google Analytics (opcional — omitir deshabilita GA completamente)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
