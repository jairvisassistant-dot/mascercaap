# ──────────────────────────────────────────────────────────────
# Mas Cerca AP — App Unificada — Variables de entorno
# En desarrollo: copiar a .env.local y completar los valores
# En Hostinger:  cargar cada variable en hPanel > Node.js > App
#
# NOTA POST-MIGRACIÓN:
#   - ADMIN_APP_URL fue eliminada (el admin vive en /admin)
#   - NEXT_PUBLIC_MAIN_APP_URL fue eliminada (misma app)
# ──────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # Solo usado en lib/admin/supabase-service.ts (server-only)

# ── Admin ──────────────────────────────────────────────────────
ADMIN_EMAIL=                       # Email del único usuario autorizado en Supabase Auth

# ── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_TO_EMAIL=
RESEND_FROM_EMAIL=noreply@mascercaap.com

# ── WhatsApp Business ─────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=57XXXXXXXXXX
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ── Google Analytics (opcional) ───────────────────────────────
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Cache revalidation (POST /api/revalidate?token=...) ───────
REVALIDATE_SECRET=                 # Cualquier string secreto, ej: openssl rand -hex 32

# ── Chat (feature flags) ──────────────────────────────────────
# Server-only booleans. Only the literal string "true" enables a flag.
# CHAT_ENABLED is the master switch; while it is false, every dependent flag
# stays ineffective. Never prefix these with NEXT_PUBLIC_.
# Full inventory and decision gates: docs/chat/phase0-decision-record.md
CHAT_ENABLED=false            # Master switch — Technical owner
CHAT_PUSH_ENABLED=false       # Coordinator Web Push — Technical owner
CHAT_EMAIL_ENABLED=false      # Visitor email resume links (Resend) — Technical owner
CHAT_BOT_ENABLED=false        # Deterministic first-line bot — Product owner (D6)
# CHAT_RETENTION_ENABLED is the kill switch for the manual cleanup endpoint
# POST /api/chat/internal/retention-cleanup?olderThanDays=<n>; the retention
# window is a REQUIRED per-run parameter (no default, D1 open) and no scheduler
# is configured yet (D5 open).
CHAT_RETENTION_ENABLED=false  # Manual cleanup endpoint — Technical owner (D1/D5)
# CHAT_MARKETING_ENABLED gates commercial SENDING only; an explicit visitor
# opt-in is still recorded as consent evidence on the entry form (period,
# frequency and channel pending D2/D4).
CHAT_MARKETING_ENABLED=false  # Consent-based commercial outreach — Product/legal owner (D2/D4)

# ── Chat (MariaDB data plane) ─────────────────────────────────
# Server-only. Never prefix these with NEXT_PUBLIC_: the browser never reaches
# MariaDB. These three credentials are required to build a connection; the
# migration runner also reads CHAT_DB_* and fails fast when they are missing.
# CHAT_DB_HOST is fixed to 127.0.0.1 because Hostinger denies the IPv6 loopback
# ("localhost"). Real values come from hPanel in Phase 1 and are never committed.
# See docs/chat/phase0-decision-record.md for the full inventory.
CHAT_DB_HOST=127.0.0.1             # Fixed IPv4 loopback — non-secret
CHAT_DB_PORT=3306                  # MariaDB port — from hPanel (default 3306)
CHAT_DB_NAME=                      # Chat schema/database — from hPanel
CHAT_DB_USER=                      # DB user — credential, hPanel only
CHAT_DB_PASSWORD=                  # DB password — secret, hPanel only
CHAT_DB_POOL_SIZE=8                # Bounded 1-10; Hostinger cap is 75 connections
CHAT_DB_CONNECT_TIMEOUT_MS=10000   # Bounded 1-120000
CHAT_DB_QUERY_TIMEOUT_MS=15000     # Bounded 1-120000
# Optional. Directory of committed .sql migrations, never generated output.
# CHAT_MIGRATIONS_DIR=lib/chat/migrations

# ── Chat (visitor session & resume token) ─────────────────────
# Server-only. Never prefix these with NEXT_PUBLIC_. Names and placeholders
# only; real secrets come from hPanel and are never committed.
# CHAT_SESSION_SECRET signs the visitor HttpOnly cookie and is rotation-capable:
# provide a comma-separated key ring where the FIRST entry signs new cookies and
# every entry (current + previous) still verifies old ones. Each entry must be at
# least 32 characters. Shape only: <current-secret>,<previous-secret>
CHAT_SESSION_SECRET=                    # Cookie signing key ring — secret, hPanel only
CHAT_SESSION_TTL_SECONDS=2592000        # Session TTL; bounded 300..31536000 (default 2592000 = 30d)
CHAT_RESUME_TOKEN_TTL_SECONDS=604800    # Resume-link TTL; bounded 60..2592000 (default 604800 = 7d)

# ── Chat (Web Push & internal email worker) ────────────────────
# Server-only. Names and placeholders only; real values come from hPanel and are
# never committed. Push stays silent until all three VAPID variables exist.
CHAT_VAPID_PUBLIC_KEY=      # VAPID public key (base64url P-256) — non-secret
CHAT_VAPID_PRIVATE_KEY=     # VAPID private key — secret, hPanel only
CHAT_VAPID_SUBJECT=         # VAPID subject, e.g. mailto:ops@example.com — non-secret
# CHAT_INTERNAL_SECRET authorizes the scheduler against
# POST /api/chat/internal/email-worker via the x-chat-internal-secret header.
CHAT_INTERNAL_SECRET=       # Internal worker shared secret — secret, hPanel only
