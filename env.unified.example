# ──────────────────────────────────────────────────────────────
# Mas Cerca AP — App Unificada — Variables de entorno
# En desarrollo: copiar a .env.local y completar los valores
# En Hostinger:  cargar cada variable en hPanel > Node.js > App
#
# NOTA POST-MIGRACIÓN:
#   - ADMIN_APP_URL fue eliminada (el admin vive en /admin)
#   - NEXT_PUBLIC_MAIN_APP_URL fue eliminada (misma app)
# ──────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # Solo usado en lib/admin/supabase-service.ts (server-only)

# ── Admin ──────────────────────────────────────────────────────
ADMIN_EMAIL=                       # Email del único usuario autorizado en Supabase Auth

# ── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_TO_EMAIL=
RESEND_FROM_EMAIL=noreply@mascercaap.com

# ── WhatsApp Business ─────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=57XXXXXXXXXX
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ── Google Analytics (opcional) ───────────────────────────────
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Cache revalidation (POST /api/revalidate?token=...) ───────
REVALIDATE_SECRET=                 # Cualquier string secreto, ej: openssl rand -hex 32
