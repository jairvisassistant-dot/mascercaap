# ──────────────────────────────────────────────────────────────
# Mas Cerca AP — Admin App — Variables de entorno
# En desarrollo: copiar a admin-app/.env.local y completar
# En Hostinger:  cargar cada variable en hPanel > Node.js > App
#                (esta app vive en el subdirectorio admin-app/)
# ──────────────────────────────────────────────────────────────

# Supabase — anon key para login, service role para operaciones admin
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email del administrador autorizado (debe coincidir con el usuario en Supabase Auth)
ADMIN_EMAIL=admin@mascercap.com

# URL del sitio público (para el link "volver al sitio" en el login)
# Desarrollo: http://localhost:3000
# Produccion: https://mascercap.com
NEXT_PUBLIC_MAIN_APP_URL=http://localhost:3000
